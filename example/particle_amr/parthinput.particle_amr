<parthenon/job>
problem_id = particle_amr

<parthenon/mesh>
refinement = adaptive
numlevel = 3

nx1 = 32
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 1

<parthenon/time>
tlim = 2.0
nlim = 100000
integrator = rk1

<parthenon/static_refinement0>
x1min = -0.3
x1max = 0.3
x2min = -0.3
x2max = 0.3
level = 1

<parthenon/static_refinement1>
x1min = -0.15
x1max = 0.15
x2min = -0.15
x2max = 0.15
level = 2

<Background>
cfl = 0.3
v = 0.5

<Particles>
num_particles = 20000
refine_above = 50
derefine_below = 10

<parthenon/output0>
file_type = hdf5
dt = 0.2
variables = advected, particle_count
swarms = particles
swarm_variables = id
