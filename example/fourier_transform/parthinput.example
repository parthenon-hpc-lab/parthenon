<parthenon/job>
problem_id = fourier_transform_example

<parthenon/mesh>
refinement = none
nghost = 3

nx1 = 16
x1min = -2.0
x1max = 2.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 16
x2min = -2.0
x2max = 2.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 16
x3min = -2.0
x3max = 2.0
ix3_bc = periodic
ox3_bc = periodic

# How many meshblocks to use in a premade default kernel.
# A value of <1 means use the whole mesh.
pack_size = -1

<parthenon/meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<parthenon/output0>
file_type = hdf5
variables = in_or_out
