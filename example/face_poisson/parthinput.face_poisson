<parthenon/job>
problem_id = face_poisson

<parthenon/mesh>
refinement = none
multigrid = true

nx1 = 64
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 64
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1 = 16
nx2 = 16
nx3 = 1

<face_poisson>
solver = MG # or CG, BiCGSTAB
alpha = 1.0
internal_prolongation = Average # or TothAndRoe
restriction = FullWeighting # or MetadataDefault

<face_poisson/solver_params>
max_iterations = 40
residual_tolerance = 1.e-10
print_per_step = true
smoother = SRJ2
do_FAS = true
